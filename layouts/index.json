{{- /* 홈 검색바가 쓰는 색인: 회사별 이름·종목코드·리포트 수·회사 페이지 주소 */ -}}
{{- $index := slice -}}
{{- with site.GetPage "/companies" -}}
  {{- range .Sections -}}
    {{- $n := len (where (where site.RegularPages "Section" "reports") "Params.code" .Params.code) -}}
    {{- $index = $index | append (dict "name" .Title "code" .Params.code "count" $n "permalink" .RelPermalink) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
